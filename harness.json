{
  "name": "personal-agent-skills",
  "owner": "Tera-Dark",
  "repo": "Tera-Dark/personal-agent-skills",
  "branch": "main",
  "bundle_dir": "bundle",
  "web_first": {
    "enabled": true,
    "primary_entry": "https://github.com/Tera-Dark/personal-agent-skills",
    "runtime_entry": "https://raw.githubusercontent.com/Tera-Dark/personal-agent-skills/main/bundle/HARNESS.md",
    "full_runtime_entry": "https://raw.githubusercontent.com/Tera-Dark/personal-agent-skills/main/bundle/HARNESS-FULL.md",
    "module_entry_pattern": "https://raw.githubusercontent.com/Tera-Dark/personal-agent-skills/main/bundle/modules/<name>.md",
    "local_runtime_required": false
  },
  "kernel": "kernel/KERNEL.md",
  "layers": [
    "00_core",
    "01_router",
    "02_design",
    "03_prompt",
    "04_analysis",
    "05_tools",
    "06_evaluation",
    "07_extensions"
  ],
  "always_on": {
    "personal-identity-profile": [
      "references/identity-quickstart.md",
      "references/taste-core.md"
    ],
    "creative-skill-router": [
      "references/router-quickstart.md"
    ]
  },
  "handshake": "Harness v{version} loaded · {modules} modules · 说需求，或发参考图。",
  "core_budget_tokens": 6600,
  "pipeline": {
    "aesthetic_gate": "aesthetic-director-core",
    "blueprint_gate": {
      "character": "character-design-engine",
      "illustration": "illustration-direction"
    },
    "prompt_core": "visual-prompt-core",
    "danbooru_tag_gate": "danbooru-tag-gate",
    "evaluation_gate": "evaluation-loop",
    "adapters": [
      "anima-renderer",
      "nai5-renderer",
      "general-image-prompt-adapter"
    ],
    "pipeline_packs": {
      "anima": [
        "visual-prompt-core",
        "danbooru-tag-gate",
        "anima-renderer"
      ],
      "nai5": [
        "visual-prompt-core",
        "danbooru-tag-gate",
        "nai5-renderer"
      ]
    }
  },
  "failure_policy": {
    "default_mode": "fail_closed",
    "standalone_module": {
      "on_fetch_failure": "card_only",
      "label": "[card-only]",
      "may_continue_with_other_loaded_modules": true,
      "memory_substitution": false
    },
    "pipeline_pack": {
      "on_fetch_failure": "pipeline_unavailable",
      "label": "[pipeline-unavailable]",
      "may_emit_model_specific_prompt": false,
      "may_use_already_loaded_modules": true,
      "memory_substitution": false
    },
    "danbooru_tag_index": {
      "on_fetch_failure": "unverified_to_nl",
      "label": "[tag-index-unavailable]",
      "hard_tags_allowed": false,
      "nl_fallback": true,
      "fuzzy_promotion": false,
      "memory_substitution": false
    }
  },
  "knowledge_tiers": {
    "l1_core_target_tokens": 5500,
    "l1_max_tokens": 6600,
    "task_packs": {
      "portrait": {
        "source": "kernel/task-packs/portrait.md",
        "modules": [
          "aesthetic-director-core",
          "character-design-engine",
          "illustration-direction"
        ]
      },
      "cinematic-duo": {
        "source": "kernel/task-packs/cinematic-duo.md",
        "modules": [
          "aesthetic-director-core",
          "illustration-direction",
          "japanese-cinematic-composition"
        ]
      },
      "concept-poster": {
        "source": "kernel/task-packs/concept-poster.md",
        "modules": [
          "aesthetic-director-core",
          "illustration-direction",
          "small-artist-brain"
        ]
      },
      "fast-variant": {
        "source": "kernel/task-packs/fast-variant.md",
        "modules": [
          "illustration-direction",
          "character-design-engine"
        ]
      }
    }
  }
}
